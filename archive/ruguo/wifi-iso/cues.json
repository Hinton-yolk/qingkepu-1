[
 {
  "t0": 0.2,
  "t1": 2.93,
  "text": "如果你的眼睛，突然能看见 Wi-Fi？"
 },
 {
  "t0": 2.95,
  "t1": 4.64,
  "text": "好，我们把现实改一下。"
 },
 {
  "t0": 4.95,
  "t1": 6.85,
  "text": "路由器亮了，一圈一圈往外推"
 },
 {
  "t0": 6.87,
  "t1": 9.39,
  "text": "你的手机，也在回应它"
 },
 {
  "t0": 9.45,
  "t1": 11.05,
  "text": "隔着墙，邻居家的也亮着"
 },
 {
  "t0": 11.07,
  "t1": 13.8,
  "text": "楼上楼下，整栋楼都在发光"
 },
 {
  "t0": 14.2,
  "t1": 16.57,
  "text": "但真实的世界，没这么整齐"
 },
 {
  "t0": 16.7,
  "t1": 18.06,
  "text": "墙会削弱它"
 },
 {
  "t0": 18.08,
  "t1": 19.87,
  "text": "你的身体会挡住它"
 },
 {
  "t0": 19.89,
  "t1": 21.59,
  "text": "冰箱会把它弹回来"
 },
 {
  "t0": 21.95,
  "t1": 24.1,
  "text": "几路波撞在一起，乱成一张网"
 },
 {
  "t0": 24.12,
  "t1": 26.59,
  "text": "手机挪几厘米，信号都可能变"
 },
 {
  "t0": 26.7,
  "t1": 28.96,
  "text": "到了街上，每扇窗、每部手机"
 },
 {
  "t0": 28.98,
  "t1": 31.59,
  "text": "连蓝牙耳机都在发光"
 },
 {
  "t0": 31.7,
  "t1": 32.48,
  "text": "整座城市"
 },
 {
  "t0": 32.5,
  "t1": 34.89,
  "text": "泡在一片从不熄灭的光雾里"
 },
 {
  "t0": 35.45,
  "t1": 35.657,
  "text": "等等"
 },
 {
  "t0": 35.677,
  "t1": 37.65,
  "text": "你可能，根本看不清"
 },
 {
  "t0": 37.95,
  "t1": 39.22,
  "text": "你以为 Wi-Fi 的波很小？"
 },
 {
  "t0": 39.24,
  "t1": 41.89,
  "text": "其实一整条波，差不多有这么长"
 },
 {
  "t0": 41.95,
  "t1": 43.21,
  "text": "可你的瞳孔只有几毫米"
 },
 {
  "t0": 43.23,
  "t1": 44.7,
  "text": "刚才那些清楚的圆圈"
 },
 {
  "t0": 44.72,
  "t1": 46.09,
  "text": "你一个也看不见"
 },
 {
  "t0": 46.2,
  "t1": 48.33,
  "text": "要看清它，眼睛得有几百米宽"
 },
 {
  "t0": 48.35,
  "t1": 49.61,
  "text": "所以真正的问题是"
 },
 {
  "t0": 49.63,
  "t1": 52.58,
  "text": "什么样的眼睛，才有资格看见 Wi-Fi？"
 },
 {
  "t0": 52.95,
  "t1": 54.76,
  "text": "人类真的造过这样一只眼睛"
 },
 {
  "t0": 54.78,
  "t1": 56.93,
  "text": "中国天眼，口径 500 米"
 },
 {
  "t0": 56.95,
  "t1": 59.36,
  "text": "可它最怕的，恰恰就是手机和 Wi-Fi"
 },
 {
  "t0": 59.38,
  "t1": 61.89,
  "text": "方圆 5 公里内，禁止带手机"
 },
 {
  "t0": 62.45,
  "t1": 63.763,
  "text": "所以就算真能看见 Wi-Fi"
 },
 {
  "t0": 63.783,
  "t1": 66.27,
  "text": "你看到的，也只是一片模糊、拥挤"
 },
 {
  "t0": 66.29,
  "t1": 68.22,
  "text": "从不停歇的电磁海洋"
 },
 {
  "t0": 68.7,
  "t1": 70.75,
  "text": "下一个如果，你想看什么？"
 }
]