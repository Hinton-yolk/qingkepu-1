[
 {
  "t0": 0.45,
  "t1": 1.89,
  "text": "如果你的眼睛能看见 Wi-Fi"
 },
 {
  "t0": 1.91,
  "t1": 2.85,
  "text": "你家会变成这样"
 },
 {
  "t0": 2.87,
  "t1": 5.28,
  "text": "墙是透明的，你却是黑的"
 },
 {
  "t0": 5.95,
  "t1": 7.19,
  "text": "Wi-Fi 其实也是光"
 },
 {
  "t0": 7.21,
  "t1": 8.77,
  "text": "只是波长有 12 厘米"
 },
 {
  "t0": 8.79,
  "t1": 11.4,
  "text": "比你看见的光长了约 25 万倍"
 },
 {
  "t0": 11.45,
  "t1": 12.7,
  "text": "波越长，光子越轻"
 },
 {
  "t0": 12.72,
  "t1": 14.2,
  "text": "眼睛里的感光分子"
 },
 {
  "t0": 14.22,
  "t1": 15.84,
  "text": "要被光子推一下才会翻身"
 },
 {
  "t0": 15.86,
  "t1": 18.23,
  "text": "Wi-Fi 的光子太轻，推不动"
 },
 {
  "t0": 18.45,
  "t1": 20.82,
  "text": "原来不是它太暗，是它太轻"
 },
 {
  "t0": 21.45,
  "t1": 22.61,
  "text": "连这个分子都推不动"
 },
 {
  "t0": 22.63,
  "t1": 24.88,
  "text": "就更打不断你 DNA 里的化学键"
 },
 {
  "t0": 24.9,
  "t1": 26.14,
  "text": "这叫非电离辐射"
 },
 {
  "t0": 26.16,
  "t1": 28.16,
  "text": "它最多让东西微微发热"
 },
 {
  "t0": 28.2,
  "t1": 29.54,
  "text": "微波炉用的也是这个频段"
 },
 {
  "t0": 29.56,
  "t1": 31.83,
  "text": "所以它一开，旁边的 Wi-Fi 会卡"
 },
 {
  "t0": 32.45,
  "t1": 33.61,
  "text": "要是真能看见"
 },
 {
  "t0": 33.63,
  "t1": 35.87,
  "text": "路由器是一盏灯，木门几乎透明"
 },
 {
  "t0": 35.89,
  "t1": 36.87,
  "text": "金属是镜子"
 },
 {
  "t0": 36.89,
  "t1": 39.1,
  "text": "满身是水的你，是一团黑影"
 },
 {
  "t0": 39.2,
  "t1": 40.33,
  "text": "可你什么都看不清"
 },
 {
  "t0": 40.35,
  "t1": 41.383,
  "text": "要像现在这么清楚"
 },
 {
  "t0": 41.403,
  "t1": 43.36,
  "text": "眼睛得有 500 米宽"
 },
 {
  "t0": 43.7,
  "t1": 45.59,
  "text": "人类真造了这样一只眼：天眼"
 },
 {
  "t0": 45.61,
  "t1": 47.0,
  "text": "去看它得先交手机"
 },
 {
  "t0": 47.02,
  "t1": 49.92,
  "text": "因为在它眼里，你的手机亮得刺眼"
 },
 {
  "t0": 50.45,
  "t1": 52.59,
  "text": "反过来，你会反射 Wi-Fi"
 },
 {
  "t0": 52.61,
  "t1": 53.69,
  "text": "它也就能看见你"
 },
 {
  "t0": 53.71,
  "t1": 55.99,
  "text": "隔着墙，它能从反射回来的信号里"
 },
 {
  "t0": 56.01,
  "t1": 57.44,
  "text": "读出你的呼吸"
 },
 {
  "t0": 57.95,
  "t1": 58.88,
  "text": "你看不见 Wi-Fi"
 },
 {
  "t0": 58.9,
  "t1": 60.71,
  "text": "但 Wi-Fi 已经能看见你了"
 }
]