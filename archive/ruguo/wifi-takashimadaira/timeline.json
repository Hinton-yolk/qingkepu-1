 "lines": [
  {
   "id": "L01",
   "start": 0.32,
   "on": 0.4,
   "off": 3.68,
   "parts": [
    {
     "text": "如果你的眼睛能看见 Wi-Fi",
     "on": 0.4,
     "off": 2.0,
     "t0": 0.34,
     "t1": 2.0
    },
    {
     "text": "晚上看一栋楼，会是这样",
     "on": 2.1,
     "off": 3.68,
     "t0": 2.04,
     "t1": 4.28
    }
   ]
  },
  {
   "id": "L02",
   "start": 4.94,
   "on": 5.0,
   "off": 8.96,
   "parts": [
    {
     "text": "这是东京高岛平团地的一栋板楼",
     "on": 5.0,
     "off": 7.74,
     "t0": 4.94,
     "t1": 7.75
    },
    {
     "text": "14 层，差不多 100 米长",
     "on": 7.85,
     "off": 8.96,
     "t0": 7.79,
     "t1": 9.4
    }
   ]
  },
  {
   "id": "L03",
   "start": 9.45,
   "on": 9.5,
   "off": 12.69,
   "parts": [
    {
     "text": "按每户一台路由器估算",
     "on": 9.5,
     "off": 11.05,
     "t0": 9.44,
     "t1": 11.16
    },
    {
     "text": "这一栋就有 200 多台",
     "on": 11.26,
     "off": 12.69,
     "t0": 11.2,
     "t1": 13.4
    }
   ]
  },
  {
   "id": "L04",
   "start": 13.44,
   "on": 13.5,
   "off": 17.78,
   "parts": [
    {
     "text": "就算没人上网",
     "on": 13.5,
     "off": 14.54,
     "t0": 13.44,
     "t1": 14.57
    },
    {
     "text": "每台路由器每秒也要喊大约 10 次",
     "on": 14.67,
     "off": 16.91,
     "t0": 14.61,
     "t1": 17.07
    },
    {
     "text": "「我在这儿」",
     "on": 17.17,
     "off": 17.78,
     "t0": 17.11,
     "t1": 18.4
    }
   ]
  },
  {
   "id": "L05",
   "start": 18.44,
   "on": 18.5,
   "off": 23.54,
   "parts": [
    {
     "text": "信号不会乖乖待在屋里",
     "on": 18.5,
     "off": 20.02,
     "t0": 18.44,
     "t1": 20.03
    },
    {
     "text": "它穿过墙，溢出窗外",
     "on": 20.13,
     "off": 21.74,
     "t0": 20.07,
     "t1": 21.77
    },
    {
     "text": "在楼下一圈一圈地扩散",
     "on": 21.87,
     "off": 23.54,
     "t0": 21.81,
     "t1": 24.4
    }
   ]
  },
  {
   "id": "L06",
   "start": 24.45,
   "on": 24.5,
   "off": 27.17,
   "parts": [
    {
     "text": "隔壁那栋，也一样",
     "on": 24.5,
     "off": 25.68,
     "t0": 24.44,
     "t1": 25.88
    },
    {
     "text": "再隔壁，也一样",
     "on": 25.98,
     "off": 27.17,
     "t0": 25.92,
     "t1": 27.9
    }
   ]
  },
  {
   "id": "L07",
   "start": 27.93,
   "on": 28.0,
   "off": 30.7,
   "parts": [
    {
     "text": "单是这一片，估计就有 6000 多台",
     "on": 28.0,
     "off": 30.0,
     "t0": 27.94,
     "t1": 30.04
    },
    {
     "text": "同时亮着",
     "on": 30.14,
     "off": 30.7,
     "t0": 30.08,
     "t1": 31.88
    }
   ]
  },
  {
   "id": "L08",
   "start": 33.95,
   "on": 34.0,
   "off": 34.85,
   "parts": [
    {
     "text": "你看不见它们",
     "on": 34.0,
     "off": 34.85,
     "t0": 33.94,
     "t1": 35.74
    }
   ]
  },
  {
   "id": "L09",
   "start": 36.55,
   "on": 36.6,
   "off": 39.23,
   "parts": [
    {
     "text": "可每天晚上，这里都是另一种万家灯火",
     "on": 36.6,
     "off": 39.23,
     "t0": 36.54,
     "t1": 39.83
    }
   ]
  }
 ],
