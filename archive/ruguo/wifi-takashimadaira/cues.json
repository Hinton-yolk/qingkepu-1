[
 {
  "t0": 0.34,
  "t1": 2.0,
  "text": "如果你的眼睛能看见 Wi-Fi"
 },
 {
  "t0": 2.04,
  "t1": 4.28,
  "text": "晚上看一栋楼，会是这样"
 },
 {
  "t0": 4.94,
  "t1": 7.75,
  "text": "这是东京高岛平团地的一栋板楼"
 },
 {
  "t0": 7.79,
  "t1": 9.4,
  "text": "14 层，差不多 100 米长"
 },
 {
  "t0": 9.44,
  "t1": 11.16,
  "text": "按每户一台路由器估算"
 },
 {
  "t0": 11.2,
  "t1": 13.4,
  "text": "这一栋就有 200 多台"
 },
 {
  "t0": 13.44,
  "t1": 14.57,
  "text": "就算没人上网"
 },
 {
  "t0": 14.61,
  "t1": 17.07,
  "text": "每台路由器每秒也要喊大约 10 次"
 },
 {
  "t0": 17.11,
  "t1": 18.4,
  "text": "「我在这儿」"
 },
 {
  "t0": 18.44,
  "t1": 20.03,
  "text": "信号不会乖乖待在屋里"
 },
 {
  "t0": 20.07,
  "t1": 21.77,
  "text": "它穿过墙，溢出窗外"
 },
 {
  "t0": 21.81,
  "t1": 24.4,
  "text": "在楼下一圈一圈地扩散"
 },
 {
  "t0": 24.44,
  "t1": 25.88,
  "text": "隔壁那栋，也一样"
 },
 {
  "t0": 25.92,
  "t1": 27.9,
  "text": "再隔壁，也一样"
 },
 {
  "t0": 27.94,
  "t1": 30.04,
  "text": "单是这一片，估计就有 6000 多台"
 },
 {
  "t0": 30.08,
  "t1": 31.88,
  "text": "同时亮着"
 },
 {
  "t0": 33.94,
  "t1": 35.74,
  "text": "你看不见它们"
 },
 {
  "t0": 36.54,
  "t1": 39.83,
  "text": "可每天晚上，这里都是另一种万家灯火"
 }
]