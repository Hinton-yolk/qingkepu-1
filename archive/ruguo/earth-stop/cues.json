[
 {
  "t0": 0.2,
  "t1": 2.67,
  "text": "想象黄昏时分，你正在阳台上"
 },
 {
  "t0": 2.69,
  "t1": 4.71,
  "text": "品着刚刚做好的手冲"
 },
 {
  "t0": 4.95,
  "t1": 7.61,
  "text": "如果此刻，地球突然停止自转"
 },
 {
  "t0": 7.63,
  "t1": 8.68,
  "text": "会发生什么呢？"
 },
 {
  "t0": 8.7,
  "t1": 11.41,
  "text": "好，让我们把现实修改一下"
 },
 {
  "t0": 12.2,
  "t1": 13.59,
  "text": "太阳停在了天上"
 },
 {
  "t0": 13.61,
  "t1": 16.61,
  "text": "这个黄昏，永远不会结束"
 },
 {
  "t0": 16.95,
  "t1": 18.15,
  "text": "但有一个问题"
 },
 {
  "t0": 18.2,
  "t1": 19.04,
  "text": "你其实一直在跑"
 },
 {
  "t0": 19.06,
  "t1": 20.84,
  "text": "在北京，脚下的地面"
 },
 {
  "t0": 20.86,
  "t1": 23.08,
  "text": "每小时往东跑一千二百多公里"
 },
 {
  "t0": 23.1,
  "t1": 24.21,
  "text": "比声音还快"
 },
 {
  "t0": 24.45,
  "t1": 26.43,
  "text": "只是所有东西都跟着它一起跑"
 },
 {
  "t0": 26.45,
  "t1": 27.39,
  "text": "你才没感觉"
 },
 {
  "t0": 27.7,
  "t1": 29.0,
  "text": "现在，地面停了"
 },
 {
  "t0": 29.02,
  "t1": 30.12,
  "text": "可你没停"
 },
 {
  "t0": 30.45,
  "t1": 31.77,
  "text": "杯子先飞出去"
 },
 {
  "t0": 31.79,
  "t1": 33.28,
  "text": "然后是你、街上的车"
 },
 {
  "t0": 33.3,
  "t1": 34.48,
  "text": "没绑牢的一切"
 },
 {
  "t0": 34.5,
  "t1": 36.52,
  "text": "都以这个速度往东冲"
 },
 {
  "t0": 36.7,
  "t1": 37.88,
  "text": "空气也没停"
 },
 {
  "t0": 37.9,
  "t1": 39.24,
  "text": "每小时一千多公里的风"
 },
 {
  "t0": 39.26,
  "t1": 42.05,
  "text": "是有记录最强阵风的三倍多"
 },
 {
  "t0": 42.2,
  "t1": 42.94,
  "text": "海也没停"
 },
 {
  "t0": 42.96,
  "t1": 45.88,
  "text": "整片大洋，往东拍向每一块大陆"
 },
 {
  "t0": 46.7,
  "t1": 48.19,
  "text": "好，那我们换个温柔点的"
 },
 {
  "t0": 48.21,
  "t1": 50.51,
  "text": "让它花几十年，慢慢停"
 },
 {
  "t0": 51.2,
  "t1": 52.21,
  "text": "没人被甩飞"
 },
 {
  "t0": 52.23,
  "t1": 54.24,
  "text": "可太阳也没停住，只是走得很慢"
 },
 {
  "t0": 54.26,
  "t1": 56.23,
  "text": "一天，变成了一年"
 },
 {
  "t0": 56.45,
  "t1": 58.88,
  "text": "黄昏，一次就有将近一个星期"
 },
 {
  "t0": 58.9,
  "t1": 60.6,
  "text": "然后，是半年的黑夜"
 },
 {
  "t0": 60.95,
  "t1": 63.0,
  "text": "但真正的变化，在海里"
 },
 {
  "t0": 63.2,
  "t1": 64.35,
  "text": "因为地球一直在转"
 },
 {
  "t0": 64.37,
  "t1": 63.39,
  "text": "赤道一直被往外甩"
 },
 {
  "t0": 63.41,
  "t1": 66.75,
  "text": "地球腰粗了一圈"
 },
 {
  "t0": 66.77,
  "t1": 68.34,
  "text": "海水也堆在那儿"
 },
 {
  "t0": 68.45,
  "t1": 69.73,
  "text": "不转了，没人甩了"
 },
 {
  "t0": 69.75,
  "t1": 71.47,
  "text": "海水就往两极流"
 },
 {
  "t0": 71.7,
  "t1": 73.48,
  "text": "北边的平原沉进海里"
 },
 {
  "t0": 73.5,
  "t1": 75.0,
  "text": "哈尔滨在一公里深的水下"
 },
 {
  "t0": 75.02,
  "t1": 77.13,
  "text": "南海，大半露出了海底"
 },
 {
  "t0": 77.7,
  "t1": 80.27,
  "text": "你以为最可怕的，是被甩出去"
 },
 {
  "t0": 80.29,
  "t1": 82.13,
  "text": "其实，我们一直都被它「甩」着"
 },
 {
  "t0": 82.15,
  "t1": 84.41,
  "text": "海在哪、岸在哪，都靠它转着"
 },
 {
  "t0": 86.2,
  "t1": 88.31,
  "text": "下一个如果，你想看什么？"
 }
]