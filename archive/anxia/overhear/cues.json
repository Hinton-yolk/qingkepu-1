[
 {
  "t0": 0.2,
  "t1": 2.47,
  "text": "想象一下，饭桌上，你随口说了一句"
 },
 {
  "t0": 2.49,
  "t1": 4.46,
  "text": "最近想买个空气炸锅"
 },
 {
  "t0": 4.7,
  "t1": 6.44,
  "text": "饭还没吃完，一打开手机"
 },
 {
  "t0": 6.46,
  "t1": 8.7,
  "text": "空气炸锅就推过来了"
 },
 {
  "t0": 8.72,
  "t1": 10.49,
  "text": "它是不是，在偷听你？"
 },
 {
  "t0": 11.2,
  "t1": 13.32,
  "text": "那就当它，真的在听"
 },
 {
  "t0": 13.45,
  "t1": 14.49,
  "text": "你说的每个字"
 },
 {
  "t0": 14.51,
  "t1": 16.84,
  "text": "都被收进麦克风，飞进机房"
 },
 {
  "t0": 16.95,
  "t1": 18.01,
  "text": "「空气炸锅」一亮"
 },
 {
  "t0": 18.03,
  "t1": 19.49,
  "text": "广告就飞了回来"
 },
 {
  "t0": 19.7,
  "t1": 20.62,
  "text": "一切都说得通"
 },
 {
  "t0": 20.64,
  "t1": 22.57,
  "text": "可是，有一个问题"
 },
 {
  "t0": 22.95,
  "t1": 24.4,
  "text": "就算你关掉麦克风权限"
 },
 {
  "t0": 24.42,
  "t1": 26.8,
  "text": "它照样能把空气炸锅推给你"
 },
 {
  "t0": 26.95,
  "t1": 29.26,
  "text": "它根本不用听，它有别的线索"
 },
 {
  "t0": 29.45,
  "t1": 32.11,
  "text": "三天前，你在一条空气炸锅视频上"
 },
 {
  "t0": 32.13,
  "t1": 33.15,
  "text": "停了六秒"
 },
 {
  "t0": 33.2,
  "t1": 35.28,
  "text": "刚才饭桌上，你朋友顺手搜了一句"
 },
 {
  "t0": 35.3,
  "t1": 37.11,
  "text": "空气炸锅哪款好？"
 },
 {
  "t0": 37.2,
  "t1": 38.75,
  "text": "你们连着同一个 Wi-Fi"
 },
 {
  "t0": 38.77,
  "t1": 40.41,
  "text": "坐在同一张桌边"
 },
 {
  "t0": 40.43,
  "t1": 42.51,
  "text": "在系统眼里，可能就是一伙的"
 },
 {
  "t0": 42.7,
  "t1": 44.22,
  "text": "再加上一天刷几百条"
 },
 {
  "t0": 44.24,
  "t1": 45.32,
  "text": "沾边的总会冒出来"
 },
 {
  "t0": 45.34,
  "t1": 47.55,
  "text": "你只记住了猜中的那一次"
 },
 {
  "t0": 47.7,
  "t1": 49.45,
  "text": "它到底听没听，谁也说不准"
 },
 {
  "t0": 49.47,
  "t1": 51.81,
  "text": "可就算不听，它也早就知道了"
 },
 {
  "t0": 52.2,
  "t1": 53.21,
  "text": "想让它少猜你"
 },
 {
  "t0": 53.23,
  "t1": 55.64,
  "text": "去设置里，关掉「个性化广告」"
 },
 {
  "t0": 55.66,
  "t1": 57.78,
  "text": "法律规定，必须给你这个开关"
 },
 {
  "t0": 57.95,
  "t1": 59.02,
  "text": "广告不会变少"
 },
 {
  "t0": 59.04,
  "t1": 61.37,
  "text": "但它就不能再照着你来猜了"
 },
 {
  "t0": 61.7,
  "t1": 63.69,
  "text": "你刚说完，广告就来了"
 },
 {
  "t0": 63.71,
  "t1": 65.93,
  "text": "因为在你开口之前，它就猜到了"
 }
]