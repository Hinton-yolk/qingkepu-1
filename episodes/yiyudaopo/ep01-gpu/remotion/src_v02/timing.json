{
 "version": "v02（导演工作稿，原文）",
 "engine": "piper",
 "total": 97.654,
 "lines": [
  {
   "id": "A1",
   "seq": "A",
   "text": "你问 AI 一个问题，背后可能有 GPU 在帮它计算。",
   "start": 0.15,
   "end": 3.854,
   "file": "vo/A1.wav"
  },
  {
   "id": "A2",
   "seq": "A",
   "text": "奇怪了。",
   "start": 4.004,
   "end": 4.767,
   "file": "vo/A2.wav"
  },
  {
   "id": "A3",
   "seq": "A",
   "text": "AI 又不打游戏，为什么还要用显卡？",
   "start": 5.017,
   "end": 7.528,
   "file": "vo/A3.wav"
  },
  {
   "id": "B1",
   "seq": "B",
   "text": "先看游戏。",
   "start": 8.028,
   "end": 9.091,
   "file": "vo/B1.wav"
  },
  {
   "id": "B2",
   "seq": "B",
   "text": "一幅画面里，许多地方都要计算光照和颜色。",
   "start": 9.241,
   "end": 12.864,
   "file": "vo/B2.wav"
  },
  {
   "id": "B3",
   "seq": "B",
   "text": "数据不一样，但很多计算规则是相似的。",
   "start": 13.064,
   "end": 16.3,
   "file": "vo/B3.wav"
  },
  {
   "id": "B4",
   "seq": "B",
   "text": "既然能一起算，为什么非要排队呢？",
   "start": 16.6,
   "end": 18.947,
   "file": "vo/B4.wav"
  },
  {
   "id": "B5",
   "seq": "B",
   "text": "GPU 的一个优势，就是能高效处理大量这样的并行任务。",
   "start": 19.297,
   "end": 23.93,
   "file": "vo/B5.wav"
  },
  {
   "id": "C1",
   "seq": "C",
   "text": "那 AI 呢？",
   "start": 24.43,
   "end": 25.094,
   "file": "vo/C1.wav"
  },
  {
   "id": "C2",
   "seq": "C",
   "text": "文字会先变成模型能够处理的数字。",
   "start": 25.294,
   "end": 28.137,
   "file": "vo/C2.wav"
  },
  {
   "id": "C3",
   "seq": "C",
   "text": "接下来，是大量的数学运算。",
   "start": 28.337,
   "end": 30.294,
   "file": "vo/C3.wav"
  },
  {
   "id": "C4",
   "seq": "C",
   "text": "比如，二乘四，加三乘五，得到二十三。",
   "start": 30.594,
   "end": 33.439,
   "file": "vo/C4.wav"
  },
  {
   "id": "C5",
   "seq": "C",
   "text": "换一组参数，按同样的规则，又能算出另一个结果。",
   "start": 34.139,
   "end": 37.84,
   "file": "vo/C5.wav"
  },
  {
   "id": "C6",
   "seq": "C",
   "text": "当许多组计算一起展开，就能得到大量输出。",
   "start": 38.44,
   "end": 42.304,
   "file": "vo/C6.wav"
  },
  {
   "id": "C7",
   "seq": "C",
   "text": "这也是神经网络中矩阵计算的一种简化示意。",
   "start": 42.504,
   "end": 45.998,
   "file": "vo/C7.wav"
  },
  {
   "id": "D1",
   "seq": "D",
   "text": "发现了吗？",
   "start": 46.498,
   "end": 47.259,
   "file": "vo/D1.wav"
  },
  {
   "id": "D2",
   "seq": "D",
   "text": "游戏和 AI，看起来完全不同，却都包含大量适合并行的数值计算。",
   "start": 47.559,
   "end": 52.785,
   "file": "vo/D2.wav"
  },
  {
   "id": "D3",
   "seq": "D",
   "text": "CPU 很灵活，擅长处理各种任务和复杂控制。",
   "start": 53.385,
   "end": 57.194,
   "file": "vo/D3.wav"
  },
  {
   "id": "D4",
   "seq": "D",
   "text": "GPU 则把更多资源用在高吞吐的并行运算上。",
   "start": 57.444,
   "end": 61.148,
   "file": "vo/D4.wav"
  },
  {
   "id": "D5",
   "seq": "D",
   "text": "当然，CPU 也能并行，GPU 也不是什么都更快。",
   "start": 61.498,
   "end": 65.241,
   "file": "vo/D5.wav"
  },
  {
   "id": "D6",
   "seq": "D",
   "text": "关键是，AI 的很多矩阵运算，恰好适合 GPU 的设计。",
   "start": 65.541,
   "end": 69.507,
   "file": "vo/D6.wav"
  },
  {
   "id": "D7",
   "seq": "D",
   "text": "所以，GPU 并不是因为会画游戏，才适合 AI。",
   "start": 69.907,
   "end": 73.163,
   "file": "vo/D7.wav"
  },
  {
   "id": "D8",
   "seq": "D",
   "text": "而是它原本擅长的计算方式，在 AI 时代有了新的用途。",
   "start": 73.313,
   "end": 77.501,
   "file": "vo/D8.wav"
  },
  {
   "id": "E1",
   "seq": "E",
   "text": "如今的 AI 加速器，还加入了专门加速矩阵计算的硬件。",
   "start": 78.101,
   "end": 82.597,
   "file": "vo/E1.wav"
  },
  {
   "id": "E2",
   "seq": "E",
   "text": "不过，算得快就够了吗？",
   "start": 82.897,
   "end": 84.551,
   "file": "vo/E2.wav"
  },
  {
   "id": "E3",
   "seq": "E",
   "text": "如果数据迟迟送不过来，计算单元也可能只能等待。",
   "start": 84.851,
   "end": 88.565,
   "file": "vo/E3.wav"
  },
  {
   "id": "E4",
   "seq": "E",
   "text": "所以，显存和数据搬运，同样重要。",
   "start": 88.765,
   "end": 91.12,
   "file": "vo/E4.wav"
  },
  {
   "id": "E5",
   "seq": "E",
   "text": "这些数字究竟放在哪里，又是怎么送到芯片上的？",
   "start": 91.47,
   "end": 95.161,
   "file": "vo/E5.wav"
  },
  {
   "id": "E6",
   "seq": "E",
   "text": "这就是下一个问题。",
   "start": 95.361,
   "end": 96.854,
   "file": "vo/E6.wav"
  }
 ],
