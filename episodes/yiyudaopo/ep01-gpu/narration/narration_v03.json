 "_note": "Pilot v03 旁白：在导演 v02 稿基础上按《PILOT V03》去重、改短句；开头和结尾按导演建议句。v02 在 narration_v02.json，v01 在 narration_v01.json。",
 "version": "v03",
 "lines": [
  {
   "id": "A1",
   "seq": "A",
   "pause": 0.1,
   "text": "AI 不打游戏，却大量使用 GPU。"
  },
  {
   "id": "A2",
   "seq": "A",
   "pause": 0.8,
   "text": "为什么？"
  },
  {
   "id": "B1",
   "seq": "B",
   "pause": 0.1,
   "text": "先看游戏。"
  },
  {
   "id": "B2",
   "seq": "B",
   "pause": 0.2,
   "text": "画面上的每一块，都要算光照和颜色。"
  },
  {
   "id": "B3",
   "seq": "B",
   "pause": 0.2,
   "text": "规则一样，只是数据不同。"
  },
  {
   "id": "B4",
   "seq": "B",
   "pause": 0.55,
   "text": "所以它们不必排队，可以一起算。"
  },
  {
   "id": "B5",
   "seq": "B",
   "pause": 0.45,
   "text": "这正是 GPU 擅长的。"
  },
  {
   "id": "C1",
   "seq": "C",
   "pause": 0.1,
   "text": "那 AI 呢？"
  },
  {
   "id": "C2",
   "seq": "C",
   "pause": 0.3,
   "text": "文字会先变成一串数字。"
  },
  {
   "id": "C3",
   "seq": "C",
   "pause": 0.95,
   "text": "比如，二乘四，加三乘五，得到二十三。"
  },
  {
   "id": "C4",
   "seq": "C",
   "pause": 0.95,
   "text": "同样的输入，换一行参数，就得到另一个结果：二十。"
  },
  {
   "id": "C5",
   "seq": "C",
   "pause": 0.9,
   "text": "再多换几行，规则还是一样，每一行都能同时算。"
  },
  {
   "id": "D1",
   "seq": "D",
   "pause": 0.2,
   "text": "发现了吗？"
  },
  {
   "id": "D2",
   "seq": "D",
   "pause": 0.9,
   "text": "游戏和 AI，都包含大量规则相同、可以同时进行的计算。"
  },
  {
   "id": "D3",
   "seq": "D",
   "pause": 0.45,
   "text": "CPU 的每个核心都很强，能灵活处理各种任务，多个核心也能同时干活。"
  },
  {
   "id": "D4",
   "seq": "D",
   "pause": 1.1,
   "text": "GPU 则把更多资源，用在成批处理这种相似的计算上。"
  },
  {
   "id": "D5",
   "seq": "D",
   "pause": 0.15,
   "text": "所以，GPU 不是因为会画游戏，才适合 AI。"
  },
  {
   "id": "D6",
   "seq": "D",
   "pause": 1.3,
   "text": "真正的原因，是 AI 的大量计算，恰好适合它擅长的并行处理方式。"
  },
  {
   "id": "E1",
   "seq": "E",
   "pause": 0.4,
   "text": "如今的 AI 芯片，还专门加入了加速矩阵计算的硬件。"
  },
  {
   "id": "E2",
   "seq": "E",
   "pause": 1.1,
   "text": "可是，数据如果送得不够快，计算单元就只能等着。"
  },
  {
   "id": "E3",
   "seq": "E",
   "pause": 0.2,
   "text": "算得快还不够。"
  },
  {
   "id": "E4",
   "seq": "E",
   "pause": 1.6,
   "text": "数据又是怎么及时送到芯片上的？"
  }
 ]
}