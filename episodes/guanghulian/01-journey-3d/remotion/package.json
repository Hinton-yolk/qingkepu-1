{
  "name": "guanghulian-01-journey-3d-remotion",
  "version": "0.1.0",
  "description": "一语道破 · 白话光互连 01（3D 版）：Remotion 合成与动态标注层",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "scan": "node scripts/scan-frames.mjs",
    "prestudio": "npm run scan",
    "studio": "remotion studio src/index.ts",
    "prestill": "npm run scan",
    "still": "node scripts/still.mjs",
    "predraft": "npm run scan",
    "draft": "remotion render src/index.ts Journey out/journey_draft_540x960.mp4 --scale=0.5 --crf=32 --jpeg-quality=70",
    "prerender": "npm run scan",
    "render": "remotion render src/index.ts Journey out/journey_1080x1920.mp4 --crf=16 --jpeg-quality=95",
    "pretypecheck": "npm run scan",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@remotion/layout-utils": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild": false
  }
}
