[
 {
  "id": "z01",
  "text": "AI 芯片的新闻，",
  "sub": null,
  "big": "AI 芯片的新闻，",
  "seg": "open",
  "reuse": "c01"
 },
 {
  "id": "z02",
  "text": "天天在说速度翻倍。",
  "sub": null,
  "big": "天天在说速度翻倍。",
  "seg": "open",
  "reuse": "c02"
 },
 {
  "id": "z03",
  "text": "可这就像汽车说最高时速 300，没说是在什么路上跑的。",
  "sub": "最高时速 300，在什么路上？",
  "big": null,
  "seg": "open",
  "reuse": "c03"
 },
 {
  "id": "z04",
  "text": "看懂这类新闻，先问三个问题。",
  "sub": null,
  "big": null,
  "seg": "open",
  "reuse": null
 },
 {
  "id": "z05",
  "text": "第一问：在什么路上跑出来的？",
  "sub": null,
  "big": null,
  "seg": "explain",
  "reuse": null
 },
 {
  "id": "z06",
  "text": "同样写着 224G，一个能推过一米长的铜缆，一个只跑几厘米。",
  "sub": "同样 224G：一米，还是几厘米",
  "big": null,
  "seg": "explain",
  "reuse": "c03b"
 },
 {
  "id": "z07",
  "text": "路越长、损耗越大，越难跑。",
  "sub": null,
  "big": null,
  "seg": "explain",
  "reuse": null
 },
 {
  "id": "z08",
  "text": "第二问：每传一个比特，花多少电？",
  "sub": null,
  "big": null,
  "seg": "explain",
  "reuse": null
 },
 {
  "id": "z09",
  "text": "要是每个比特的电降不下来，速度翻倍，耗电也跟着翻倍。几万颗芯片一起跑，每一点电都是成本。",
  "sub": "速度翻倍，耗电也可能翻倍",
  "big": null,
  "seg": "explain",
  "reuse": null
 },
 {
  "id": "z10",
  "text": "第三问：在真实芯片上跑通了吗？",
  "sub": null,
  "big": null,
  "seg": "reveal",
  "reuse": null
 },
 {
  "id": "z11",
  "text": "纸面和仿真里的速度，和真做出芯片、测出来的速度，是两回事。",
  "sub": "仿真 ≠ 实测",
  "big": null,
  "seg": "reveal",
  "reuse": null
 },
 {
  "id": "z12",
  "text": "一句话带走：",
  "sub": null,
  "big": null,
  "seg": "end",
  "reuse": "a19"
 },
 {
  "id": "z13",
  "text": "下次看到速度翻倍，先问三句：什么路？多少电？跑通没有？",
  "sub": null,
  "big": null,
  "seg": "end",
  "reuse": null
 },
 {
  "id": "z14",
  "text": "下一条：信号上路以后，为什么会越跑越模糊？",
  "sub": null,
  "big": null,
  "seg": "end",
  "reuse": null
 }
]