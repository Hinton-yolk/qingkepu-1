[
 {
  "id": "x01",
  "text": "AI 越来越聪明，",
  "sub": null,
  "big": "AI 越来越聪明，",
  "seg": "open",
  "reuse": "a01"
 },
 {
  "id": "x02",
  "text": "靠的是上万颗芯片一起练。",
  "sub": null,
  "big": "靠的是上万颗芯片一起练。",
  "seg": "open",
  "reuse": "a02"
 },
 {
  "id": "x03",
  "text": "它们每算一步，都要互相交换数据。",
  "sub": null,
  "big": null,
  "seg": "open",
  "reuse": null
 },
 {
  "id": "x04",
  "text": "可芯片之间最快的连接，偏偏只修几条路。",
  "sub": "最快的连接，偏偏只修几条路",
  "big": null,
  "seg": "open",
  "reuse": null
 },
 {
  "id": "x05",
  "text": "其实你早就见过：25 针的老打印机线，跑不过只有 4 根线的 USB。",
  "sub": "25 针，跑不过 4 根线",
  "big": null,
  "seg": "open",
  "reuse": "a03c"
 },
 {
  "id": "x06",
  "text": "为什么路少了，反而快？",
  "sub": null,
  "big": null,
  "seg": "open",
  "reuse": "a03d"
 },
 {
  "id": "x07",
  "text": "直觉上，路越多，一次送出去的就越多。",
  "sub": null,
  "big": null,
  "seg": "explain",
  "reuse": null
 },
 {
  "id": "x08",
  "text": "可几十条路一起送，有个前提：每一批货，必须一起到。对面等齐了，才能拼出完整的数据。",
  "sub": "每一批，必须一起到",
  "big": null,
  "seg": "explain",
  "reuse": null
 },
 {
  "id": "x09",
  "text": "跑得慢的时候，这不难：一批和一批隔得远，晚到一点也来得及。",
  "sub": null,
  "big": null,
  "seg": "explain",
  "reuse": null
 },
 {
  "id": "x10",
  "text": "可速度一快，一批接一批挤得越来越紧，留给「一起到」的时间就越来越短。",
  "sub": "越快，「一起到」的时间越短",
  "big": null,
  "seg": "explain",
  "reuse": null
 },
 {
  "id": "x11",
  "text": "这时哪怕有一条路长了一点点，那件货晚到一步，就混进了下一批，整批数据就拼错了。",
  "sub": "晚到一步，就混进了下一批",
  "big": null,
  "seg": "reveal",
  "reuse": null
 },
 {
  "id": "x12",
  "text": "路越多，越难让每一条都一样长。",
  "sub": null,
  "big": null,
  "seg": "reveal",
  "reuse": null
 },
 {
  "id": "x13",
  "text": "所以干脆反过来：只修几条路，让数据排成一列，一个接一个地跑。不用再等谁，每条路都能一路提速。",
  "sub": "排成一列，每条路一路提速",
  "big": null,
  "seg": "reveal",
  "reuse": null
 },
 {
  "id": "x14",
  "text": "一句话带走：",
  "sub": null,
  "big": null,
  "seg": "end",
  "reuse": "a19"
 },
 {
  "id": "x15",
  "text": "路少不是退步。速度一高，「一起到」比「路多」更难。",
  "sub": null,
  "big": null,
  "seg": "end",
  "reuse": null
 },
 {
  "id": "x16",
  "text": "下一条：排成一列以后，连续五个 1，对面怎么数清？",
  "sub": null,
  "big": null,
  "seg": "end",
  "reuse": null
 }
]