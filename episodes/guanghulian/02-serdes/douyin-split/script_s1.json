 {
  "id": "w04",
  "text": "路少了，凭什么更快？",
  "sub": null,
  "big": null,
  "seg": "open",
  "reuse": null,
  "say": "路少了，凭什么更快？"
 },
 {
  "id": "w05",
  "text": "几十条路一起送，有个前提：每一批都得一起到，对面才拼得出数据。",
  "sub": "每一批都得一起到",
  "big": null,
  "seg": "explain",
  "reuse": null,
  "say": "几十条路一起送，有个前提：每一批都得一起到，对面才拼得出数据。"
 },
 {
  "id": "w06",
  "text": "慢的时候不难。可一快，一批紧挨一批，留给「一起到」的时间越来越短。",
  "sub": "越快，留给「一起到」的时间越短",
  "big": null,
  "seg": "explain",
  "reuse": null,
  "say": "慢的时候不难。可一快，一批紧挨一批，留给一起到的时间越来越短。"
 },
 {
  "id": "w07",
  "text": "这时哪条路长了一点点，那一位就晚到一步，混进下一批：整批全错。",
  "sub": null,
  "big": null,
  "seg": "reveal",
  "reuse": null,
  "say": "这时哪条路长了一点点，那一位就晚到一步，混进下一批：整批全错。"
 },
 {
  "id": "w08",
  "text": "路越多，越难条条一样长。",
  "sub": null,
  "big": null,
  "seg": "reveal",
  "reuse": null,
  "say": "路越多，越难条条一样长。"
 },
 {
  "id": "w09",
  "text": "所以干脆只修几条路，排成一列跑：不用等谁，一路提速。",
  "sub": "排成一列，一路提速",
  "big": null,
  "seg": "reveal",
  "reuse": null,
  "say": "所以干脆只修几条路，排成一列跑：不用等谁，一路提速。"
 },
 {
