[
 {
  "id": "y01",
  "text": "你刷的每条视频，",
  "sub": null,
  "big": "你刷的每条视频，",
  "seg": "open",
  "reuse": "b01"
 },
 {
  "id": "y02",
  "text": "都是一串 0 和 1。",
  "sub": null,
  "big": "都是一串 0 和 1。",
  "seg": "open",
  "reuse": "b02"
 },
 {
  "id": "y03",
  "text": "可在线上，没有一个个分开的 0 和 1：连续五个 1，就是一条直线。",
  "sub": "连续五个 1，就是一条直线",
  "big": null,
  "seg": "open",
  "reuse": "b03"
 },
 {
  "id": "y04",
  "text": "是四个，还是五个？数错一个，数据就错了。",
  "sub": "四个还是五个？",
  "big": null,
  "seg": "open",
  "reuse": "b03b"
 },
 {
  "id": "y05",
  "text": "AI 芯片之间每秒要这样数上千亿个，还没人告诉它节拍。它怎么数清？",
  "sub": "没人告诉它节拍，怎么数清？",
  "big": null,
  "seg": "open",
  "reuse": "b03c"
 },
 {
  "id": "y06",
  "text": "要数清，就得知道每个比特有多长：这就是节拍。",
  "sub": null,
  "big": null,
  "seg": "explain",
  "reuse": null
 },
 {
  "id": "y07",
  "text": "秘密在这些跳变里：每次从 0 变 1、从 1 变 0，接收端就拿它对一次表。",
  "sub": "每次跳变，对一次表",
  "big": null,
  "seg": "explain",
  "reuse": null
 },
 {
  "id": "y08",
  "text": "早了，就往后拨一点；晚了，就往前拨一点。对上几次，节拍就锁住了。",
  "sub": "对上几次，节拍就锁住了",
  "big": null,
  "seg": "explain",
  "reuse": null
 },
 {
  "id": "y09",
  "text": "锁住以后，在每个比特的正中间看一眼，一个一个清点：五个，不是四个。",
  "sub": "在正中间看一眼：五个",
  "big": null,
  "seg": "reveal",
  "reuse": null
 },
 {
  "id": "y10",
  "text": "可要是一长串全是 1，没有跳变，它就没法对表，节拍会慢慢跑偏。",
  "sub": "没有跳变，节拍会跑偏",
  "big": null,
  "seg": "reveal",
  "reuse": null
 },
 {
  "id": "y11",
  "text": "所以发出去之前，数据会先被打乱，让 0 和 1 混得够勤；收到以后，再按同样的规则还原。",
  "sub": "先打乱，收到再还原",
  "big": null,
  "seg": "reveal",
  "reuse": null
 },
 {
  "id": "y12",
  "text": "一句话带走：",
  "sub": null,
  "big": null,
  "seg": "end",
  "reuse": "a19"
 },
 {
  "id": "y13",
  "text": "芯片不是在看 0 和 1，是在听节拍：每一次跳变，都是它的节拍器。",
  "sub": null,
  "big": null,
  "seg": "end",
  "reuse": null
 },
 {
  "id": "y14",
  "text": "下一条：芯片号称速度翻倍，该问它哪三个问题？",
  "sub": null,
  "big": null,
  "seg": "end",
  "reuse": null
 }
]