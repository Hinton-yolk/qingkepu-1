{"name": "s1n", "dur": 32.958, "lines": [{"id": "p01", "t0": 0.0, "t1": 1.86, "clip": 0.0, "text": "你发出去的每张照片，", "ch": [0.0, 0.186, 0.372, 0.558, 0.744, 0.93, 1.116, 1.302, 1.488, 1.674], "sub": null, "big": null, "seg": "open", "src": ""}, {"id": "p02", "t0": 1.86, "t1": 3.721, "clip": 1.86, "text": "在芯片之间都要跑一趟。", "ch": [1.86, 2.326, 2.466, 2.605, 2.744, 2.884, 3.024, 3.163, 3.303, 3.442, 3.582], "sub": null, "big": null, "seg": "open", "src": ""}, {"id": "p02b", "t0": 3.721, "t1": 5.581, "clip": 3.721, "text": "你问 AI 的每个问题、发的每张照片，背后都是芯片之间在疯狂寄快递。", "ch": [3.721, 3.736, 3.751, 3.766, 3.781, 3.796, 3.811, 3.826, 3.841, 3.856, 3.871, 3.886, 3.901, 3.916, 3.931, 3.946, 3.961, 3.976, 3.991, 4.006, 4.021, 4.036, 4.051, 4.066, 4.081, 4.096, 4.111, 4.126, 4.141, 4.156, 4.171, 4.186, 4.651, 5.116], "sub": null, "big": null, "seg": "open", "src": ""}, {"id": "p03", "t0": 5.581, "t1": 8.372, "clip": 5.581, "text": "直觉上，修几十条路，把照片切成几十条一起送，最快。", "ch": [5.581, 5.581, 5.581, 5.581, 5.581, 5.581, 5.581, 5.581, 5.581, 5.581, 5.581, 5.581, 5.581, 5.581, 5.86, 6.139, 6.419, 6.698, 6.977, 7.176, 7.376, 7.575, 7.774, 7.973, 8.173], "sub": null, "big": null, "seg": "explain", "src": ""}, {"id": "p04", "t0": 8.372, "t1": 11.163, "clip": 8.372, "text": "慢的时候确实没问题：每一条都按时到，照片拼得严丝合缝。", "ch": [8.372, 8.457, 8.541, 8.626, 8.71, 8.795, 8.88, 8.964, 9.049, 9.133, 9.218, 9.303, 9.387, 9.472, 9.556, 9.641, 9.725, 9.81, 9.895, 9.979, 10.064, 10.148, 10.233, 10.419, 10.605, 10.791, 10.977], "sub": null, "big": null, "seg": "explain", "src": ""}, {"id": "p05", "t0": 11.163, "t1": 16.279, "clip": 11.163, "text": "可速度一快，一张紧跟着一张；哪条路长了一点点，那一条就晚到半步，拼进了下一张。", "ch": [11.163, 11.163, 11.163, 11.163, 11.349, 11.535, 11.721, 11.907, 12.093, 12.196, 12.3, 12.403, 12.506, 12.61, 12.713, 12.816, 12.92, 13.023, 13.116, 13.209, 13.302, 13.395, 13.488, 13.581, 13.674, 13.767, 13.86, 13.953, 14.139, 14.325, 14.512, 14.698, 14.884, 15.083, 15.283, 15.482, 15.681, 15.88, 16.08], "sub": null, "big": null, "seg": "reveal", "src": ""}, {"id": "p06", "t0": 16.744, "t1": 18.605, "clip": 16.744, "text": "照片就成了这样。", "ch": [16.744, 16.977, 17.209, 17.442, 17.675, 17.907, 18.14, 18.372], "sub": null, "big": null, "seg": "reveal", "src": ""}, {"id": "p07", "t0": 18.605, "t1": 21.395, "clip": 18.605, "text": "聊天、转账也一样：没有纠错的话，错一位，意思就全变了。", "ch": [18.605, 18.663, 18.721, 18.779, 18.837, 18.896, 18.954, 19.012, 19.07, 19.128, 19.186, 19.244, 19.303, 19.361, 19.419, 19.477, 19.535, 19.704, 19.873, 20.042, 20.211, 20.38, 20.55, 20.719, 20.888, 21.057, 21.226], "sub": null, "big": null, "seg": "reveal", "src": ""}, {"id": "p08", "t0": 21.395, "t1": 23.256, "clip": 21.395, "text": "路越多，越难让每一条都一样长。", "ch": [21.395, 21.519, 21.643, 21.767, 21.891, 22.015, 22.139, 22.263, 22.388, 22.512, 22.636, 22.76, 22.884, 23.008, 23.132], "sub": null, "big": null, "seg": "reveal", "src": ""}, {"id": "p09", "t0": 23.256, "t1": 27.907, "clip": 23.256, "text": "所以最快的芯片反过来：只修几条路，让数据排成一队，一个接一个跑。不用等谁，就能越跑越快。", "ch": [23.256, 23.256, 23.256, 23.256, 23.256, 23.256, 23.256, 23.256, 23.256, 23.256, 23.256, 23.256, 23.463, 23.669, 23.876, 24.083, 24.289, 24.496, 24.703, 24.909, 25.116, 25.165, 25.214, 25.263, 25.312, 25.361, 25.41, 25.459, 25.508, 25.557, 25.606, 25.655, 25.704, 25.753, 25.802, 25.851, 25.9, 25.949, 25.998, 26.047, 26.419, 26.791, 27.163, 27.535], "sub": null, "big": null, "seg": "reveal", "src": ""}, {"id": "p10", "t0": 28.372, "t1": 28.837, "clip": 28.372, "text": "一句话带走：", "ch": [28.372, 28.45, 28.527, 28.605, 28.682, 28.759], "sub": null, "big": null, "seg": "end", "src": ""}, {"id": "p11", "t0": 28.837, "t1": 30.698, "clip": 28.837, "text": "路少，反而不会乱。", "ch": [28.837, 29.023, 29.209, 29.395, 29.581, 29.767, 30.0, 30.233, 30.465], "sub": null, "big": null, "seg": "end", "src": ""}, {"id": "p12", "t0": 30.698, "t1": 32.558, "clip": 30.698, "text": "下一条：排成一队以后，对面怎么知道数到了第几个？", "ch": [30.698, 30.776, 30.853, 30.931, 31.008, 31.085, 31.163, 31.241, 31.318, 31.395, 31.473, 31.55, 31.628, 31.706, 31.783, 31.861, 31.938, 32.016, 32.093, 32.17, 32.248, 32.325, 32.403, 32.48], "sub": null, "big": null, "seg": "end", "src": ""}], "shots": [{"kind": "photo", "t0": 0, "first": "p01", "paper": false, "t1": 3.721}, {"kind": "route", "t0": 3.721, "first": "p02b", "topic": "", "paper": false, "t1": 5.481000000000001}, {"kind": "strips", "t0": 5.481000000000001, "first": "p03", "paper": false, "t1": 23.056}, {"kind": "serial", "t0": 23.056, "first": "p09", "paper": false, "t1": 27.907}, {"kind": "take", "t0": 27.907, "first": "p10", "cy": 700, "type": [{"text": "一句话带走", "line": "p10", "from": null, "to": null}, {"text": "路少，", "line": "p11", "from": "路少", "to": "路少"}, {"text": "反而不会乱。", "line": "p11", "from": "反而", "to": "不会乱"}], "paper": true, "t1": 32.958}], "hudIn": 5.281000000000001, "caps": [[0.0, 2.791, "照片怎么错位了？", 540, 260], [18.805, 21.395, "转账错一位，也一样", 540, 330], [23.256, 25.116, "所以：只修几条路", 540, 1300]], "bpm": 129, "novoice": true}