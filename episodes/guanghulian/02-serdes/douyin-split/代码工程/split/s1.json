{"name": "s1", "dur": 39.26, "lines": [{"id": "w01", "t0": 0.35, "t1": 1.4, "clip": 0.29, "text": "AI 芯片之间，", "ch": [0.35, 0.481, 0.613, 0.744, 0.875, 1.006, 1.138, 1.269], "sub": null, "big": "AI 芯片之间，", "seg": "open", "src": ""}, {"id": "w02", "t0": 1.8, "t1": 3.23, "clip": 1.72, "text": "最快的路，只修几条。", "ch": [1.8, 1.943, 2.086, 2.229, 2.372, 2.515, 2.658, 2.801, 2.944, 3.087], "sub": null, "big": "最快的路，只修几条。", "seg": "open", "src": ""}, {"id": "w03", "t0": 3.63, "t1": 6.92, "clip": 3.58, "text": "就像 4 根线的 USB，跑赢了 25 针的老打印机线。", "ch": [3.63, 3.732, 3.833, 3.935, 4.036, 4.138, 4.239, 4.341, 4.442, 4.544, 4.645, 4.747, 4.848, 5.06, 5.184, 5.308, 5.432, 5.556, 5.68, 5.804, 5.928, 6.052, 6.176, 6.3, 6.424, 6.548, 6.672, 6.796], "sub": "4 根线，跑赢 25 针", "big": null, "seg": "open", "src": ""}, {"id": "w04", "t0": 7.17, "t1": 8.72, "clip": 7.12, "text": "路少了，凭什么更快？", "ch": [7.17, 7.317, 7.465, 7.612, 7.93, 8.062, 8.193, 8.325, 8.457, 8.588], "sub": null, "big": null, "seg": "open", "src": ""}, {"id": "w05", "t0": 9.17, "t1": 13.31, "clip": 9.11, "text": "几十条路一起送，有个前提：每一批都得一起到，对面才拼得出数据。", "ch": [9.17, 9.293, 9.415, 9.537, 9.66, 9.783, 9.905, 10.027, 10.26, 10.384, 10.508, 10.632, 10.756, 10.99, 11.107, 11.223, 11.34, 11.457, 11.573, 11.69, 11.807, 11.923, 12.17, 12.297, 12.423, 12.55, 12.677, 12.803, 12.93, 13.057, 13.183], "sub": "每一批都得一起到", "big": null, "seg": "explain", "src": ""}, {"id": "w06", "t0": 13.56, "t1": 18.02, "clip": 13.5, "text": "慢的时候不难。可一快，一批紧挨一批，留给「一起到」的时间越来越短。", "ch": [13.56, 13.673, 13.786, 13.899, 14.011, 14.124, 14.237, 14.52, 14.67, 14.82, 14.97, 15.23, 15.374, 15.519, 15.663, 15.807, 15.951, 16.096, 16.36, 16.471, 16.581, 16.692, 16.803, 16.913, 17.024, 17.135, 17.245, 17.356, 17.467, 17.577, 17.688, 17.799, 17.909], "sub": "越快，留给「一起到」的时间越短", "big": null, "seg": "explain", "src": ""}, {"id": "w07", "t0": 18.47, "t1": 23.28, "clip": 18.42, "text": "这时哪条路长了一点点，那一位就晚到一步，混进下一批：整批全错。", "ch": [18.47, 18.598, 18.726, 18.855, 18.983, 19.111, 19.239, 19.367, 19.495, 19.624, 19.752, 20.02, 20.163, 20.307, 20.45, 20.593, 20.737, 20.88, 21.023, 21.167, 21.52, 21.638, 21.757, 21.875, 21.993, 22.112, 22.36, 22.544, 22.728, 22.912, 23.096], "sub": null, "big": null, "seg": "reveal", "src": ""}, {"id": "w08", "t0": 24.63, "t1": 26.5, "clip": 24.58, "text": "路越多，越难条条一样长。", "ch": [24.63, 24.79, 24.95, 25.11, 25.37, 25.511, 25.652, 25.794, 25.935, 26.076, 26.218, 26.359], "sub": null, "big": null, "seg": "reveal", "src": ""}, {"id": "w09", "t0": 26.95, "t1": 30.75, "clip": 26.89, "text": "所以干脆只修几条路，排成一列跑：不用等谁，一路提速。", "ch": [26.95, 27.091, 27.232, 27.373, 27.514, 27.655, 27.796, 27.937, 28.078, 28.219, 28.48, 28.592, 28.703, 28.815, 28.927, 29.038, 29.34, 29.478, 29.616, 29.754, 29.892, 30.13, 30.254, 30.378, 30.502, 30.626], "sub": "排成一列，一路提速", "big": null, "seg": "reveal", "src": ""}, {"id": "w10", "t0": 31.2, "t1": 31.95, "clip": 31.14, "text": "一句话带走：", "ch": [31.2, 31.325, 31.45, 31.575, 31.7, 31.825], "sub": null, "big": null, "seg": "end", "src": ""}, {"id": "w11", "t0": 32.2, "t1": 34.19, "clip": 32.14, "text": "速度一高，「一起到」比「路多」更难。", "ch": [32.2, 32.424, 32.648, 32.872, 33.096, 33.43, 33.488, 33.547, 33.605, 33.664, 33.722, 33.781, 33.839, 33.898, 33.956, 34.015, 34.073, 34.132], "sub": null, "big": null, "seg": "end", "src": ""}, {"id": "w12", "t0": 34.44, "t1": 37.66, "clip": 34.38, "text": "下一条：连续五个 1，芯片怎么数清？", "ch": [34.44, 34.903, 35.365, 35.828, 36.46, 36.53, 36.6, 36.67, 36.74, 36.81, 36.88, 37.05, 37.137, 37.224, 37.311, 37.399, 37.486, 37.573], "sub": null, "big": null, "seg": "end", "src": ""}], "shots": [{"kind": "tunnel", "t0": 0, "paper": false, "first": "w01", "t1": 8.87}, {"kind": "race", "t0": 8.87, "paper": false, "first": "w05", "t1": 26.65}, {"kind": "serial", "t0": 26.65, "paper": false, "first": "w09", "t1": 30.9}, {"kind": "take", "t0": 30.9, "paper": true, "first": "w10", "type": [{"text": "一句话带走", "line": "w10", "from": null, "to": null}, {"text": "速度一高，「一起到」", "line": "w11", "from": "速度", "to": "一起到"}, {"text": "比「路多」更难。", "line": "w11", "from": "比", "to": "更难"}], "cy": 700, "t1": 39.26}], "hudIn": 8.87}