{"name": "s2", "dur": 50.59, "lines": [{"id": "q01", "t0": 0.35, "t1": 1.56, "clip": 0.29, "text": "少数一个 1，", "ch": [0.35, 0.523, 0.696, 0.869, 1.041, 1.214, 1.387], "sub": null, "big": "少数一个 1，", "seg": "open", "src": ""}, {"id": "q02", "t0": 1.96, "t1": 2.98, "clip": 1.9, "text": "这句话就全乱了。", "ch": [1.96, 2.087, 2.215, 2.342, 2.47, 2.598, 2.725, 2.853], "sub": null, "big": "这句话就全乱了。", "seg": "open", "src": ""}, {"id": "q02b", "t0": 3.38, "t1": 6.75, "clip": 3.33, "text": "芯片之间寄快递，对面签收时，得一个一个点清楚。", "ch": [3.38, 3.526, 3.672, 3.819, 3.965, 4.111, 4.258, 4.404, 4.73, 4.875, 5.02, 5.165, 5.31, 5.455, 5.72, 5.834, 5.949, 6.063, 6.178, 6.292, 6.407, 6.521, 6.636], "sub": null, "big": null, "seg": "open", "src": ""}, {"id": "q03", "t0": 7.2, "t1": 14.4, "clip": 7.14, "text": "芯片之间每秒要数上千亿个 0 和 1。可线上连着五个 1，看起来就是一条直线：四个，还是五个？", "ch": [7.2, 7.341, 7.482, 7.623, 7.764, 7.905, 8.046, 8.187, 8.328, 8.469, 8.61, 8.751, 8.892, 9.033, 9.174, 9.315, 9.456, 9.597, 9.738, 9.879, 10.03, 10.18, 10.331, 10.482, 10.633, 10.783, 10.934, 11.085, 11.235, 11.386, 11.553, 11.721, 11.888, 12.056, 12.223, 12.391, 12.558, 12.726, 12.893, 13.06, 13.228, 13.395, 13.563, 13.73, 13.898, 14.065, 14.233], "sub": null, "big": null, "seg": "open", "src": ""}, {"id": "q04", "t0": 14.65, "t1": 16.76, "clip": 14.59, "text": "没人在旁边打拍子，它怎么数清？", "ch": [14.65, 14.78, 14.91, 15.04, 15.17, 15.3, 15.43, 15.56, 15.69, 15.93, 16.068, 16.207, 16.345, 16.483, 16.622], "sub": null, "big": null, "seg": "open", "src": ""}, {"id": "q05", "t0": 17.21, "t1": 21.13, "clip": 17.15, "text": "就像你跟着一首歌拍手：没人给你打拍子，你听着鼓点，自然就跟上了。", "ch": [17.21, 17.332, 17.455, 17.578, 17.7, 17.823, 17.945, 18.068, 18.19, 18.312, 18.435, 18.558, 18.68, 18.803, 18.925, 19.047, 19.17, 19.293, 19.415, 19.538, 19.66, 19.783, 19.905, 20.027, 20.15, 20.273, 20.395, 20.518, 20.64, 20.762, 20.885, 21.008], "sub": null, "big": null, "seg": "explain", "src": ""}, {"id": "q06", "t0": 21.58, "t1": 26.95, "clip": 21.51, "text": "芯片也一样：信号每跳一下，就是一个鼓点。它跟着鼓点校准自己，几下就踩准了。", "ch": [21.58, 21.707, 21.833, 21.96, 22.087, 22.213, 22.47, 22.641, 22.813, 22.984, 23.156, 23.327, 23.499, 23.77, 23.863, 23.956, 24.049, 24.141, 24.234, 24.327, 24.57, 24.705, 24.84, 24.975, 25.11, 25.245, 25.38, 25.515, 25.65, 25.785, 26.08, 26.204, 26.329, 26.453, 26.577, 26.701, 26.826], "sub": null, "big": null, "seg": "reveal", "src": ""}, {"id": "q07", "t0": 28.0, "t1": 31.17, "clip": 27.92, "text": "踩准以后，每一拍看一眼：五个，不是四个。", "ch": [28.0, 28.159, 28.317, 28.476, 28.634, 28.793, 28.951, 29.11, 29.268, 29.427, 29.585, 29.744, 29.902, 30.061, 30.219, 30.378, 30.536, 30.695, 30.853, 31.012], "sub": null, "big": null, "seg": "reveal", "src": ""}, {"id": "q08", "t0": 31.62, "t1": 36.37, "clip": 31.57, "text": "可要是一长串全是 1，就像歌里拖了一个长音，没有鼓点，拍子就会慢慢跑偏。", "ch": [31.62, 31.743, 31.867, 31.99, 32.114, 32.237, 32.36, 32.484, 32.607, 32.73, 32.854, 32.977, 33.113, 33.249, 33.384, 33.52, 33.656, 33.791, 33.927, 34.063, 34.199, 34.334, 34.47, 34.606, 34.741, 34.877, 35.013, 35.149, 35.284, 35.42, 35.556, 35.691, 35.827, 35.963, 36.099, 36.234], "sub": null, "big": null, "seg": "reveal", "src": ""}, {"id": "q09", "t0": 36.62, "t1": 41.32, "clip": 36.56, "text": "所以发出去之前，先把数据打乱，让鼓点一直都在；收到以后，再还原回来。", "ch": [36.62, 36.758, 36.896, 37.035, 37.173, 37.311, 37.449, 37.588, 37.726, 37.864, 38.002, 38.141, 38.279, 38.417, 38.555, 38.694, 38.832, 38.97, 39.108, 39.246, 39.385, 39.523, 39.661, 39.799, 39.938, 40.076, 40.214, 40.352, 40.491, 40.629, 40.767, 40.905, 41.044, 41.182], "sub": null, "big": null, "seg": "reveal", "src": ""}, {"id": "q10", "t0": 41.77, "t1": 42.52, "clip": 41.71, "text": "一句话带走：", "ch": [41.77, 41.895, 42.02, 42.145, 42.27, 42.395], "sub": null, "big": null, "seg": "end", "src": ""}, {"id": "q11", "t0": 42.77, "t1": 45.57, "clip": 42.71, "text": "芯片数 0 和 1，靠的不是眼睛，是耳朵。", "ch": [42.77, 42.879, 42.988, 43.097, 43.206, 43.314, 43.423, 43.532, 43.641, 43.75, 43.859, 44.014, 44.17, 44.326, 44.481, 44.637, 44.792, 44.948, 45.103, 45.259, 45.414], "sub": null, "big": null, "seg": "end", "src": ""}, {"id": "q12", "t0": 45.82, "t1": 48.99, "clip": 45.76, "text": "下一条：芯片说速度翻倍，该问哪三句？", "ch": [45.82, 45.955, 46.09, 46.225, 46.51, 46.683, 46.855, 47.028, 47.2, 47.373, 47.545, 47.718, 48.15, 48.29, 48.43, 48.57, 48.71, 48.85], "sub": null, "big": null, "seg": "end", "src": ""}], "shots": [{"kind": "chat", "t0": 0, "paper": false, "first": "q01", "t1": 3.08}, {"kind": "route", "t0": 3.08, "paper": false, "first": "q02b", "topic": "对面怎么清点签收", "t1": 6.9}, {"kind": "chat2", "t0": 6.9, "paper": false, "first": "q03", "t1": 16.91}, {"kind": "clap", "t0": 16.91, "paper": false, "first": "q05", "t1": 21.28}, {"kind": "beat", "t0": 21.28, "paper": false, "first": "q06", "t1": 31.32}, {"kind": "scramble", "t0": 31.32, "paper": false, "first": "q08", "t1": 41.47}, {"kind": "take", "t0": 41.47, "paper": true, "first": "q10", "type": [{"text": "一句话带走", "line": "q10", "from": null, "to": null}, {"text": "靠的不是眼睛，", "line": "q11", "from": "靠的", "to": "眼睛"}, {"text": "是耳朵。", "line": "q11", "from": "是耳朵", "to": "耳朵"}], "cy": 700, "t1": 50.59}], "hudIn": 16.91}