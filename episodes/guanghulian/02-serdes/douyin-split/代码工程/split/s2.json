{"name": "s2", "dur": 50.11, "lines": [{"id": "q01", "t0": 0.35, "t1": 1.56, "clip": 0.29, "text": "少数一个 1，", "ch": [0.35, 0.523, 0.696, 0.869, 1.041, 1.214, 1.387], "sub": null, "big": "少数一个 1，", "seg": "open", "src": ""}, {"id": "q02", "t0": 1.96, "t1": 2.98, "clip": 1.9, "text": "这句话就全乱了。", "ch": [1.96, 2.087, 2.215, 2.342, 2.47, 2.598, 2.725, 2.853], "sub": null, "big": "这句话就全乱了。", "seg": "open", "src": ""}, {"id": "q02b", "t0": 3.38, "t1": 6.27, "clip": 3.32, "text": "这一条讲快递签收：对面怎么一个不差地清点。", "ch": [3.38, 3.518, 3.655, 3.793, 3.93, 4.068, 4.206, 4.343, 4.481, 4.619, 4.756, 4.894, 5.031, 5.169, 5.307, 5.444, 5.582, 5.72, 5.857, 5.995, 6.132], "sub": null, "big": null, "seg": "open", "src": ""}, {"id": "q03", "t0": 6.72, "t1": 13.92, "clip": 6.66, "text": "芯片之间每秒要数上千亿个 0 和 1。可线上连着五个 1，看起来就是一条直线：四个，还是五个？", "ch": [6.72, 6.861, 7.002, 7.143, 7.284, 7.425, 7.566, 7.707, 7.848, 7.989, 8.13, 8.271, 8.412, 8.553, 8.694, 8.835, 8.976, 9.117, 9.258, 9.399, 9.55, 9.7, 9.851, 10.002, 10.153, 10.303, 10.454, 10.605, 10.755, 10.906, 11.073, 11.241, 11.408, 11.576, 11.743, 11.911, 12.078, 12.246, 12.413, 12.58, 12.748, 12.915, 13.083, 13.25, 13.418, 13.585, 13.753], "sub": null, "big": null, "seg": "open", "src": ""}, {"id": "q04", "t0": 14.17, "t1": 16.28, "clip": 14.11, "text": "没人在旁边打拍子，它怎么数清？", "ch": [14.17, 14.3, 14.43, 14.56, 14.69, 14.82, 14.95, 15.08, 15.21, 15.45, 15.588, 15.727, 15.865, 16.003, 16.142], "sub": null, "big": null, "seg": "open", "src": ""}, {"id": "q05", "t0": 16.73, "t1": 20.65, "clip": 16.67, "text": "就像你跟着一首歌拍手：没人给你打拍子，你听着鼓点，自然就跟上了。", "ch": [16.73, 16.852, 16.975, 17.098, 17.22, 17.343, 17.465, 17.587, 17.71, 17.832, 17.955, 18.078, 18.2, 18.323, 18.445, 18.567, 18.69, 18.812, 18.935, 19.058, 19.18, 19.303, 19.425, 19.547, 19.67, 19.793, 19.915, 20.038, 20.16, 20.282, 20.405, 20.527], "sub": null, "big": null, "seg": "explain", "src": ""}, {"id": "q06", "t0": 21.1, "t1": 26.47, "clip": 21.03, "text": "芯片也一样：信号每跳一下，就是一个鼓点。它跟着鼓点校准自己，几下就踩准了。", "ch": [21.1, 21.227, 21.353, 21.48, 21.607, 21.733, 21.99, 22.161, 22.333, 22.504, 22.676, 22.847, 23.019, 23.29, 23.383, 23.476, 23.569, 23.661, 23.754, 23.847, 24.09, 24.225, 24.36, 24.495, 24.63, 24.765, 24.9, 25.035, 25.17, 25.305, 25.6, 25.724, 25.849, 25.973, 26.097, 26.221, 26.346], "sub": null, "big": null, "seg": "reveal", "src": ""}, {"id": "q07", "t0": 27.52, "t1": 30.69, "clip": 27.44, "text": "踩准以后，每一拍看一眼：五个，不是四个。", "ch": [27.52, 27.678, 27.837, 27.995, 28.154, 28.312, 28.471, 28.63, 28.788, 28.947, 29.105, 29.264, 29.422, 29.581, 29.739, 29.898, 30.056, 30.215, 30.373, 30.532], "sub": null, "big": null, "seg": "reveal", "src": ""}, {"id": "q08", "t0": 31.14, "t1": 35.89, "clip": 31.09, "text": "可要是一长串全是 1，就像歌里拖了一个长音，没有鼓点，拍子就会慢慢跑偏。", "ch": [31.14, 31.263, 31.387, 31.51, 31.634, 31.757, 31.88, 32.004, 32.127, 32.25, 32.374, 32.497, 32.633, 32.769, 32.904, 33.04, 33.176, 33.311, 33.447, 33.583, 33.719, 33.854, 33.99, 34.126, 34.261, 34.397, 34.533, 34.669, 34.804, 34.94, 35.076, 35.211, 35.347, 35.483, 35.619, 35.754], "sub": null, "big": null, "seg": "reveal", "src": ""}, {"id": "q09", "t0": 36.14, "t1": 40.84, "clip": 36.08, "text": "所以发出去之前，先把数据打乱，让鼓点一直都在；收到以后，再还原回来。", "ch": [36.14, 36.278, 36.416, 36.555, 36.693, 36.831, 36.969, 37.108, 37.246, 37.384, 37.522, 37.661, 37.799, 37.937, 38.075, 38.214, 38.352, 38.49, 38.628, 38.766, 38.905, 39.043, 39.181, 39.319, 39.458, 39.596, 39.734, 39.872, 40.011, 40.149, 40.287, 40.425, 40.564, 40.702], "sub": null, "big": null, "seg": "reveal", "src": ""}, {"id": "q10", "t0": 41.29, "t1": 42.04, "clip": 41.23, "text": "一句话带走：", "ch": [41.29, 41.415, 41.54, 41.665, 41.79, 41.915], "sub": null, "big": null, "seg": "end", "src": ""}, {"id": "q11", "t0": 42.29, "t1": 45.09, "clip": 42.23, "text": "芯片数 0 和 1，靠的不是眼睛，是耳朵。", "ch": [42.29, 42.399, 42.508, 42.617, 42.726, 42.834, 42.943, 43.052, 43.161, 43.27, 43.379, 43.534, 43.69, 43.846, 44.001, 44.157, 44.312, 44.468, 44.623, 44.779, 44.934], "sub": null, "big": null, "seg": "end", "src": ""}, {"id": "q12", "t0": 45.34, "t1": 48.51, "clip": 45.28, "text": "下一条：芯片说速度翻倍，该问哪三句？", "ch": [45.34, 45.475, 45.61, 45.745, 46.03, 46.203, 46.375, 46.547, 46.72, 46.892, 47.065, 47.238, 47.67, 47.81, 47.95, 48.09, 48.23, 48.37], "sub": null, "big": null, "seg": "end", "src": ""}], "shots": [{"kind": "chat", "t0": 0, "paper": false, "first": "q01", "t1": 3.08}, {"kind": "route", "t0": 3.08, "paper": false, "first": "q02b", "topic": "对面怎么清点签收", "t1": 6.42}, {"kind": "chat2", "t0": 6.42, "paper": false, "first": "q03", "t1": 16.43}, {"kind": "clap", "t0": 16.43, "paper": false, "first": "q05", "t1": 20.8}, {"kind": "beat", "t0": 20.8, "paper": false, "first": "q06", "t1": 30.84}, {"kind": "scramble", "t0": 30.84, "paper": false, "first": "q08", "t1": 40.99}, {"kind": "take", "t0": 40.99, "paper": true, "first": "q10", "type": [{"text": "一句话带走", "line": "q10", "from": null, "to": null}, {"text": "靠的不是眼睛，", "line": "q11", "from": "靠的", "to": "眼睛"}, {"text": "是耳朵。", "line": "q11", "from": "是耳朵", "to": "耳朵"}], "cy": 700, "t1": 50.11}], "hudIn": 16.43}